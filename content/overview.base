views:
  - type: table
    name: 文章属性
    filters:
      and:
        - "!date.isEmpty()"
    order:
      - title
      - file.folder
      - tags
      - date
    sort:
      - property: file.folder
        direction: ASC
      - property: date
        direction: ASC
    columnSize:
      note.tags: 783
      note.date: 226
